# CallingAgent Configuration
# (Optional if using the Free Browser Simulator. Required for real PSTN mobile calls via Twilio)

# Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Twilio Secret Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Virtual Caller ID / Phone Number (E.164 format, e.g. +1234567890 or Indian virtual CLI)
TWILIO_PHONE_NUMBER=+1234567890

# Optional: Preferred Polly Voice (e.g. Polly.Aditi, Polly.Kajal)
VOICE_NAME=Polly.Aditi
